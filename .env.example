# NYX Backend Environment Variables
# Copy this file to .env and fill in your API keys

# LLM Provider API Keys (add the ones you have)
GROQ_API_KEY=
SAMBA_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=

# Database Configuration (optional)
DATABASE_URL=sqlite:///./nyx_data.db

# Vector Database Configuration (optional)
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_PROVIDER=qdrant
