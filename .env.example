# NYX Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="NYX Decision Intelligence API"
APP_VERSION="2.1.0"
DEBUG=false
ENVIRONMENT=development  # development, staging, production, testing

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# CORS SETTINGS (CRITICAL FOR SECURITY)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://nyx-frontend.vercel.app
# NEVER set this to true in production!
ALLOW_WILDCARD_CORS=false

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# SQLite for development
DATABASE_URL=sqlite:///./nyx.db

# PostgreSQL for production (uncomment and configure)
# DATABASE_URL=postgresql://user:password@host:5432/nyx

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# LLM PROVIDER KEYS (Add your API keys)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# =============================================================================
# REDIS CACHE (Optional but recommended for production)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate a strong secret key for JWT signing
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text
ENABLE_METRICS=true
METRICS_PORT=9090
